\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Formal statistical evidence for regime structure. \textbf  {Left}: Autocorrelation function of squared log-returns---significant spikes through lag~20 confirm volatility clustering ($Q(20)=847.3$, $p<0.001$). \textbf  {Centre}: Return distributions by regime; the Mann--Whitney test ($U=2{,}341{,}887$, $p<0.001$) rejects equality. \textbf  {Right}: Bootstrap mean returns per regime with 95\% CIs---non-overlapping intervals confirm economically significant separation.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:eda_regime}{{2}{7}{Formal statistical evidence for regime structure. \textbf {Left}: Autocorrelation function of squared log-returns---significant spikes through lag~20 confirm volatility clustering ($Q(20)=847.3$, $p<0.001$). \textbf {Centre}: Return distributions by regime; the Mann--Whitney test ($U=2{,}341{,}887$, $p<0.001$) rejects equality. \textbf {Right}: Bootstrap mean returns per regime with 95\% CIs---non-overlapping intervals confirm economically significant separation}{figure.caption.7}{}}
